{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "click",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "local_protocol": "https"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  // Apex custom domain. `wrangler deploy` creates the DNS record and certificate
  // on the clickmcp.com zone in this account. No dashboard step.
  // workers.dev is off. A brand-new account has no workers.dev subdomain, and
  // non-interactive wrangler will not create one. The custom domain is the URL.
  "routes": [
    {
      "pattern": "clickmcp.com",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["17 4 * * *"]
  },
  // Deploys run `npm run deploy`: scripts/build-worker.mjs splits the bundle into dist/worker/,
  // then `wrangler deploy dist/worker/index.js --no-bundle` uploads index.js and its chunks.
  "find_additional_modules": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.js"], "fallthrough": true }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/brand/click.css"]
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  // Email verification for new clicks. clickmcp.com is onboarded to Cloudflare Email
  // Sending (cf-bounce MX/SPF, DKIM selector cf-bounce, DMARC). With this binding present,
  // creating a click always emails a 6-digit code before the key is issued.
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["verify@clickmcp.com"] }],
  "vars": {
    "ALLOW_UNVERIFIED_SIGNUP": "false",
    "EMAIL_FROM": "verify@clickmcp.com"
  },
  "durable_objects": {
    "bindings": [
      { "name": "CLICK", "class_name": "ClickHub" },
      { "name": "DIRECTORY", "class_name": "ClickDirectory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ClickHub"] },
    { "tag": "v2", "new_sqlite_classes": ["ClickDirectory"] }
  ]
}
