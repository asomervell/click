{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "click",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "dev": {
    "ip": "127.0.0.1",
    "port": 8787,
    "local_protocol": "https"
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  // Apex custom domain. `wrangler deploy` creates the DNS record and certificate
  // on the clickmcp.com zone in this account. No dashboard step.
  // workers_dev stays on so the workers.dev hostname keeps working; OAuth
  // issuer and resource are taken from the request origin, not hardcoded.
  "routes": [
    {
      "pattern": "clickmcp.com",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["17 4 * * *"]
  },
  "secrets": {
    "required": ["OWNER_KEY_HASH"]
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "durable_objects": {
    "bindings": [{ "name": "CLICK", "class_name": "ClickHub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ClickHub"] }]
}
