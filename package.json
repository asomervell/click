{
  "name": "clickmcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "clickmcp": "./cli/clickmcp.mjs"
  },
  "license": "Apache-2.0",
  "description": "MCP bridge so agents on different accounts can register and message each other.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "wrangler types && tsc --noEmit && tsc -p test --noEmit",
    "hash-owner-key": "node scripts/hash-owner-key.mjs",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "agents": "^0.33.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@emnapi/core": "^1.7.1",
    "@emnapi/runtime": "^1.7.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.160.1"
  }
}
